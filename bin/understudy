#!/usr/bin/env python3
"""A6 replayable degradation card; generation itself stays with the official model."""
import argparse
import sys
from pathlib import Path
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from lib import tools
from lib.understudy import render


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    tools.add_common_args(parser)
    parser.add_argument('--parent')
    parser.add_argument('--config')
    replay = tools.maybe_replay(parser, argv)
    ctx = tools.make_context(__file__)
    if replay:
        args = parser.parse_args(tools.replay_args(replay))
        tools.emit(render(ctx.root, args.parent, args.config, replay['seed']))
        return 0
    args = parser.parse_args(argv)
    if not args.parent or not args.config:
        parser.error('--parent and --config are required')
    entrant = tools.require_entrant(parser, args)
    seed = tools.draw_seed(args.seed)
    def produce():
        if entrant != 'A6':
            raise ValueError('understudy belongs to A6')
        return render(ctx.root, args.parent, args.config, seed)
    output, path = tools.run_tool(ctx, entrant, argv, [args.parent, args.config],
                                  seed, 'replay-exact', None, produce)
    tools.emit(output)
    tools.report_receipt(path)
    return 0


if __name__ == '__main__':
    tools.exit_on_error(main)
