#!/usr/bin/env python3
"""E3 complete-roster keyword routing; frame-dependence enforcement remains separate."""
import argparse
import sys
from pathlib import Path
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from lib import tools
from lib.route import inputs, render


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    tools.add_common_args(parser)
    parser.add_argument('--brief')
    parser.add_argument('--index', default='references/roster.md')
    parser.add_argument('--domain-specialist')
    replay = tools.maybe_replay(parser, argv)
    ctx = tools.make_context(__file__)
    if replay:
        args = parser.parse_args(tools.replay_args(replay))
        tools.emit(render(ctx.root, args.brief, args.index, args.domain_specialist))
        return 0
    args = parser.parse_args(argv)
    if not args.brief or not args.domain_specialist:
        parser.error('--brief and --domain-specialist are required')
    entrant = tools.require_entrant(parser, args)
    def produce():
        if entrant != 'E3':
            raise ValueError('route belongs to E3')
        return render(ctx.root, args.brief, args.index, args.domain_specialist)
    output, path = tools.run_tool(ctx, entrant, argv, inputs(ctx.root, args.brief, args.index),
                                  tools.NO_SEED, 'replay-exact', None, produce)
    tools.emit(output)
    tools.report_receipt(path)
    return 0


if __name__ == '__main__':
    tools.exit_on_error(main)
