#!/usr/bin/env python3
"""Enforce E3's independently evaluated deletion verdict and sealed evidence."""
from __future__ import annotations

import argparse
import sys
from pathlib import Path
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from lib import tools
from lib.errors import ToolError
from lib.frame_audit import INPUT_NAMES, KIND, compute
from lib.forage_audit import safe_path
from lib.paths import head_commit


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    tools.add_common_args(parser)
    for name in INPUT_NAMES + ('previous',):
        parser.add_argument('--' + name.replace('_', '-'))
    parser.add_argument('--seal-commit')
    args = parser.parse_args(argv)
    if args.replay_of:
        raise ToolError('model verdict is hash-attested; validate its sealed evidence')
    entrant = tools.require_entrant(parser, args)
    try:
        paths = {name: safe_path(getattr(args, name)) for name in INPUT_NAMES}
        if args.previous:
            paths['previous'] = safe_path(args.previous)
    except ValueError as exc:
        raise ToolError(str(exc)) from exc
    ctx = tools.make_context(__file__)
    seed = tools.draw_seed(args.seed)
    attestation = {'kind': KIND, 'seal_commit': args.seal_commit, 'paths': paths}
    def produce():
        claim = {'tool': 'frame-gate', 'entrant': entrant, 'status': 'ok',
                 'verification_class': 'hash-attested', 'external_attestation': attestation,
                 'repo_commit': head_commit(ctx.root), 'inputs': tools.hash_inputs(ctx.root, list(paths.values())),
                 'argv': list(argv), 'seed': seed}
        return compute(ctx.root, claim)
    output, path = tools.run_tool(ctx, entrant, argv, list(paths.values()), seed,
                                  'hash-attested', attestation, produce)
    tools.emit(output)
    tools.report_receipt(path)
    return 0


if __name__ == '__main__':
    tools.exit_on_error(main)
