#!/usr/bin/env python3
"""E5 frozen era lexicon checker; preserves rejected drafts in receipts."""
import argparse
import sys
from pathlib import Path
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from lib import tools
from lib.lexicon import render


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    tools.add_common_args(parser)
    for name in ('lexicon', 'profile', 'candidate', 'specialist', 'previous'):
        parser.add_argument('--' + name)
    parser.add_argument('--era', type=int)
    replay = tools.maybe_replay(parser, argv)
    ctx = tools.make_context(__file__)
    if replay:
        args = parser.parse_args(tools.replay_args(replay))
        tools.emit(render(ctx.root, args))
        return 0
    args = parser.parse_args(argv)
    if any(getattr(args, name) is None for name in ('lexicon', 'profile', 'candidate', 'specialist', 'era')):
        parser.error('lexicon, profile, candidate, specialist and era are required')
    entrant = tools.require_entrant(parser, args)
    paths = [args.lexicon, args.profile, args.candidate] + ([args.previous] if args.previous else [])
    def produce():
        if entrant != 'E5':
            raise ValueError('lexicon-check belongs to E5')
        return render(ctx.root, args)
    output, path = tools.run_tool(ctx, entrant, argv, paths, tools.NO_SEED, 'replay-exact', None, produce)
    tools.emit(output)
    tools.report_receipt(path)
    return 0


if __name__ == '__main__':
    tools.exit_on_error(main)
