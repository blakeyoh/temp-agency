#!/usr/bin/env python3
"""E4 replayable crossover-only builder; not the complete breeding contract."""
import argparse
import sys
from pathlib import Path
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from lib import tools
from lib.breed import render


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    tools.add_common_args(parser)
    parser.add_argument('--parent-a')
    parser.add_argument('--parent-b')
    replay = tools.maybe_replay(parser, argv)
    ctx = tools.make_context(__file__)
    if replay:
        args = parser.parse_args(tools.replay_args(replay))
        tools.emit(render(ctx.root, args.parent_a, args.parent_b, replay['seed']))
        return 0
    args = parser.parse_args(argv)
    if not args.parent_a or not args.parent_b:
        parser.error('--parent-a and --parent-b are required')
    entrant = tools.require_entrant(parser, args)
    seed = tools.draw_seed(args.seed)
    def produce():
        if entrant != 'E4':
            raise ValueError('breed belongs to E4')
        return render(ctx.root, args.parent_a, args.parent_b, seed)
    output, path = tools.run_tool(ctx, entrant, argv, [args.parent_a, args.parent_b],
                                  seed, 'replay-exact', None, produce)
    tools.emit(output)
    tools.report_receipt(path)
    return 0


if __name__ == '__main__':
    tools.exit_on_error(main)
